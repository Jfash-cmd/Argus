# Database (SQLite)
DATABASE_URL="file:./dev.db"

# Telegram Bot Token (from @BotFather)
# e.g., 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_TOKEN="demo_token_or_paste_from_botfather"

# Public Bot Username (without @) used for Telegram Login Widget
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="ArgonAlertsBot"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Timezone (Default: Africa/Lagos)
APP_TIMEZONE="Africa/Lagos"
